# Copier vers .env sur le VPS / coller dans Portainer (Stack → Environment variables)
# Deux comptes typiques :
#   ADMIN_EMAILS=dev@delhomme.ovh
#   AUTH_ALLOWED_EMAILS=dev@delhomme.ovh,pavel@delhomme.ovh
#   (pavel@ = perso prod ; dev@ = admin + tests)

NODE_ENV=production
PORT=8787
APP_ENV=production
APP_URL=https://ytmusic.delhomme.ovh

# Obligatoire — génère avec: openssl rand -hex 32
JWT_SECRET=

# Sessions multi-appareils
JWT_ACCESS_TTL=14d
AUTH_COOKIE_MS=34560000000
COOKIE_SECURE=1

# --- Mode privé (défaut dès APP_ENV=production|preprod) ---
AUTH_ALLOW_REGISTER=0
AUTH_ALLOW_GUEST=0
AUTH_ALLOWED_EMAILS=dev@delhomme.ovh,pavel@delhomme.ovh
ADMIN_EMAILS=dev@delhomme.ovh

# Seed admin uniquement (ne pas mettre pavel@ ici si AUTH_SEED_SYNC=1)
SEED_EMAIL=dev@delhomme.ovh
SEED_PASSWORD=
AUTH_SEED_SYNC=1

# Optionnel : protège le lien APK (?key=…) — laisse vide pour QR Admin simple
# APK_DOWNLOAD_TOKEN=

# Google Sign-In (optionnel — même email allowlisté)
GOOGLE_CLIENT_ID=

# Passkeys — doit matcher le domaine public HTTPS
WEBAUTHN_RP_ID=ytmusic.delhomme.ovh
WEBAUTHN_ORIGIN=https://ytmusic.delhomme.ovh

# SMTP — renseigner dans .env / Portainer (jamais de secrets ici)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USE_SSL=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Image GHCR (après push branche prod)
YTMUSIC_IMAGE=ghcr.io/paveldelhomme/ytmusic:latest

AUDD_API_TOKEN=
