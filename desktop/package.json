{
  "name": "plm-desktop",
  "version": "1.3.113",
  "private": true,
  "description": "PLM desktop (shell Electron → PWA prod)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:dir": "electron-builder --linux dir"
  },
  "build": {
    "appId": "ovh.delhomme.plm.desktop",
    "productName": "PLM",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
