# =============================================================================
# PLM — variables d’environnement (exemple)
# Copie :  cp .env.example .env   puis renseigne les secrets dans .env uniquement
# Les DEUX fichiers doivent avoir les MÊMES clés (même ordre) — valeurs secrètes
# uniquement dans .env (jamais committer .env).
# Vérifier : make env-check
# =============================================================================

# --- Auth / JWT --------------------------------------------------------------
JWT_SECRET=
GOOGLE_CLIENT_ID=
# Optional: Google OAuth client ID (Google Cloud Console → Identity Services)

# Comptes admin (emails séparés par des virgules) — à renseigner dans .env
ADMIN_EMAILS=

# Environnement : local | preprod | production
APP_ENV=local

# Base URL des liens email (validation, etc.) — DOIT être joignable par le navigateur / téléphone
# local   : http://127.0.0.1:8787   (API sert /verify-email ; adb reverse pour mobile)
# preprod : https://ytmusic-preprod.delhomme.ovh
# prod    : https://ytmusic.delhomme.ovh
# Ne pas mettre :5173 en lien mail si le téléphone doit ouvrir le lien (passe par l’API).
APP_URL=http://127.0.0.1:8787

# Origines CORS additionnelles (virgules). Local : LAN auto-autorisée.
# Prod/préprod : liste stricte (APP_URL + front).
# CORS_ORIGINS=https://ytmusic.delhomme.ovh,https://ytmusic-preprod.delhomme.ovh

# Base URL API pour le client Android (appareil physique ≠ 127.0.0.1)
# Priorité au build APK :
#   1) ANDROID_API_BASE_URL (si défini)
#   2) APP_URL si hors localhost (prod / préprod)
#   3) IP LAN auto :8787 (dev même Wi‑Fi) — JAMAIS 127.0.0.1 sur téléphone
# Exemples :
#   ANDROID_API_BASE_URL=https://ytmusic.delhomme.ovh
#   ANDROID_API_BASE_URL=https://ytmusic-preprod.delhomme.ovh
#   ANDROID_API_BASE_URL=http://192.168.1.134:8787
# Ou : API_BASE_URL=… make android / make android-publish
# Admin → Déploiement mobile → Compiler l’APK (QR /api/deploy/apk)
ANDROID_API_BASE_URL=
# Base URL publique HTTPS (APK prod, fallback LAN→distant, docs/Makefile).
# Ex. la valeur de DEPLOY_URL / ton domaine prod — ne pas hardcoder ailleurs.
PUBLIC_API_URL=

# Sessions longues (access JWT + refresh ~400j, sliding — multi-appareils)
# Le refresh n’est plus invalidé à chaque appel (évite déconnexions multi-onglets).
# Rotation one-shot optionnelle : REFRESH_ROTATE=1
JWT_ACCESS_TTL=14d
AUTH_COOKIE_MS=34560000000
# REFRESH_ROTATE=0

# --- SMTP (OVH MX Plan ou autre) ---------------------------------------------
# Local sans SMTP : laisse SMTP_HOST vide → outbox admin + logs console
# Local Mailhog (docker compose -f docker-compose.dev.yml) :
#   SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_SECURE=0  SMTP_USE_SSL=0
# Prod : renseigne USER / PASS / FROM dans .env uniquement
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USE_SSL=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Rapports batterie → email (défaut SEED_EMAIL)
BATTERY_REPORT_TO=

# Alertes crash / error télémétrie → email (défaut ADMIN_EMAILS)
TELEMETRY_ALERT_TO=
TELEMETRY_ALERT_THROTTLE_MS=90000
TELEMETRY_ALERT_DISABLE=0

# --- WebAuthn / Passkeys -----------------------------------------------------
# Defaults = hostname de la requête (localhost & LAN OK).
# En prod : WEBAUTHN_RP_ID=ytmusic.delhomme.ovh
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5173
# Origines Android Credential Manager (debug keystore) — séparées par virgules
WEBAUTHN_ANDROID_ORIGINS=android:apk-key-hash:PPbFMh2hUX55lAyeJVFKY5ssRJ4-_333R2h2y_b0wR8
# Package prod (+ .dev auto-ajouté dans assetlinks). Plusieurs : ANDROID_PACKAGE_NAMES=a,b
ANDROID_PACKAGE_NAME=ovh.delhomme.ytmusic
# Empreintes signing (debug + release séparées par virgules) pour Digital Asset Links
ANDROID_SHA256_FINGERPRINTS=3C:F6:C5:32:1D:A1:51:7E:79:94:0C:9E:25:51:4A:63:9B:2C:44:9E:3E:FF:7D:F7:47:68:76:CB:F6:F4:C1:1F

# --- API ---------------------------------------------------------------------
PORT=8787
# Cache RAM lazy des têtes de stream (démarrage titre ≪ 50–100 ms après warm)
# STREAM_HEAD_BYTES=786432
# STREAM_HEAD_CACHE=16

# --- Comptes de seed / test (scripts/dev/seed-users.mjs) ----------------------
# Compte principal de test (web + mobile Kotlin) — email déjà vérifié, admin.
# Préremplissage login : web (VITE_*) + APK debug (BuildConfig depuis ces vars).
# Secrets (SEED_PASSWORD, VITE_DEV_PASSWORD) : dans .env seulement.
BATTERY_REPORT_TO=

SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=
# Second compte seedé en même temps (même mot de passe) — optionnel
SEED_EMAIL_SECONDARY=
SEED_NAME_SECONDARY=

# Miroirs pour le front Vite (dev only — jamais en prod)
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=

# --- Recherche / reconnaissance audio (mobile) ------------------------------
# Token AudD pour /api/search/identify (écoute + fredonnement).
# Sans token → fallback public « test » (très limité). dashboard.audd.io
AUDD_API_TOKEN=

# --- Stream audio (anti-bot / formats) --------------------------------------
# Optionnel : session navigateur pour stabiliser yt-dlp sur certaines IP.
#   BROWSER=brave bash scripts/deploy/push-youtube-cookies.sh prod
# YOUTUBE_COOKIES_FILE=data/youtube-cookies.txt
# Opt-in dangereux : Chrome ouvert → souvent « Requested format is not available »
# YTDLP_COOKIES_FROM_BROWSER=0
# YTDLP_BROWSER=chrome
#
# Prod VPS-only : YouTube bloque souvent la musique depuis les IP datacenter.
# Proxy HTTP(S) résidentiel pour yt-dlp (jamais le PC maison) :
# YOUTUBE_HTTP_PROXY=http://user:pass@host:port
#
# Relais PC maison (DEV / secours) — ignoré en prod sauf ALLOW=1 :
# ALLOW_STREAM_UPSTREAM=0
# STREAM_UPSTREAM_FALLBACK=1
# (si ALLOW=1 et le PC coupe → VPS reprend au lieu d’un 502)
# STREAM_UPSTREAM / link-home-stream = tunnel + fichier data/stream-upstream.url
#
# Ne jamais changer JWT_SECRET ni « Remove volumes » : OAuth TV + ytm_accounts
# (cookies/oauth users) sont chiffrés sur ytmusic_data.

# --- Déploiement Admin (local → VPS) — PAS de webhook Portainer (Pro) ------
DEPLOY_URL=https://ytmusic.delhomme.ovh
#
# A) Watchtower : déployer deploy/watchtower-compose.yml sur le VPS (recommandé)
#
# B) Portainer CE Access Token (profil → Access tokens) :
# PORTAINER_URL=https://portainer.ton-domaine
# PORTAINER_API_KEY=
# PORTAINER_STACK_NAME=ytmusic
# PORTAINER_ENDPOINT_ID=   # optionnel
# PORTAINER_STACK_ID=      # optionnel
#
# C) SSH :
DEPLOY_SSH=
DEPLOY_SSH_CMD=
# Exemples :
# DEPLOY_SSH=user@ip-vps
# DEPLOY_SSH_CMD=docker pull ghcr.io/paveldelhomme/ytmusic:latest && docker restart ytmusic
#
# DEPLOY_WAIT_BUILD=1
# DEPLOY_IMAGE_WAIT_SECS=120
