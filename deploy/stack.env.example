# Variables Portainer stack.env (NE PAS committer les secrets réels)
# Copier vers Portainer → Stack → Environment variables / stack.env

JWT_SECRET=change-me-long-random
SMTP_PASS=change-me
ADMIN_EMAILS=dev@delhomme.ovh
AUTH_ALLOWED_EMAILS=dev@delhomme.ovh
AUTH_ALLOW_REGISTER=0
AUTH_ALLOW_GUEST=0
APP_URL=https://ytmusic.delhomme.ovh
WEBAUTHN_RP_ID=ytmusic.delhomme.ovh
WEBAUTHN_ORIGIN=https://ytmusic.delhomme.ovh
YTMUSIC_IMAGE=ghcr.io/paveldelhomme/ytmusic:latest
SMTP_HOST=ssl0.ovh.net
SMTP_USER=noreply@maily.ovh
SMTP_FROM=YTMusic <noreply@maily.ovh>
# Anti-storm
YTDLP_MAX_CONCURRENT=4
STREAM_WARM_CONCURRENCY=1
STREAM_WARM_BATCH_CAP=6
