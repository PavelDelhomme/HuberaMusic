{
  "name": "ytmusic",
  "version": "1.3.144",
  "private": true,
  "description": "PLM — musique web, API, Android & desktop",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:all": "concurrently -n api,web -c red,cyan \"npm run dev -w api\" \"npm run dev -w web\"",
    "dev:api": "npm run dev -w api",
    "dev:server": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "dev:client": "npm run dev -w web",
    "dev:desktop": "npm run start --prefix desktop",
    "build": "npm run build -w web",
    "start": "npm run start -w api",
    "deploy:local": "npm run build && npm start",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:build": "docker build -t ytmusic:local .",
    "seed-users": "node scripts/dev/seed-users.mjs"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild@0.28.1": true
  }
}
