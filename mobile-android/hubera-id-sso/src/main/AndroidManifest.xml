        <package android:name="cloud.hubera.fuel" />
        <package android:name="cloud.hubera.pass" />
        <package android:name="cloud.hubera.mail" />
        <package android:name="cloud.hubera.drive" />
        <package android:name="cloud.hubera.photos" />
        <package android:name="cloud.hubera.calendar" />
        <package android:name="cloud.hubera.contacts" />
        <package android:name="cloud.hubera.notes" />
        <package android:name="cloud.hubera.tasks" />
        <package android:name="cloud.hubera.cook" />
        <package android:name="cloud.hubera.admin" />
        <package android:name="cloud.hubera.jobs" />
        <package android:name="cloud.hubera.office" />
        <package android:name="cloud.hubera.row" />
        <package android:name="cloud.hubera.office.docs" />
        <package android:name="cloud.hubera.slides" />
        <package android:name="cloud.hubera.budget" />
        <package android:name="cloud.hubera.stream" />
        <package android:name="cloud.hubera.cms" />
        <package android:name="fr.cloudity.cloudity_mail" />
        <package android:name="fr.cloudity.cloudity_drive" />
        <package android:name="fr.cloudity.cloudity_photos" />
        <package android:name="com.cloudity.cloudity_pass" />
        <package android:name="fr.cloudity.cloudity_calendar" />
        <package android:name="fr.cloudity.cloudity_contacts" />
        <package android:name="fr.cloudity.cloudity_notes" />
        <package android:name="fr.cloudity.cloudity_tasks" />
        <package android:name="fr.cloudity.cloudity_cook" />
        <package android:name="fr.cloudity.admin_app" />
        <provider android:authorities="cloud.hubera.id.hubera.id" />
        <provider android:authorities="cloud.hubera.music.hubera.id" />
        <provider android:authorities="cloud.hubera.music.dev.hubera.id" />
        <provider android:authorities="cloud.hubera.music.preprod.hubera.id" />
        <provider android:authorities="ovh.delhomme.ytmusic.hubera.id" />
        <provider android:authorities="cloud.hubera.docs.hubera.id" />
        <provider android:authorities="cloud.hubera.maps.hubera.id" />
        <provider android:authorities="ovh.delhomme.maps.hubera.id" />
        <provider android:authorities="cloud.hubera.fuel.hubera.id" />
        <provider android:authorities="cloud.hubera.pass.hubera.id" />
