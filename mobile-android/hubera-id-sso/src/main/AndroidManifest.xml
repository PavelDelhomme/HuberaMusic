<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="cloud.hubera.permission.READ_ID_ACCOUNT"
        android:protectionLevel="signature" />
    <permission
        android:name="cloud.hubera.permission.WRITE_ID_ACCOUNT"
        android:protectionLevel="signature" />

    <uses-permission android:name="cloud.hubera.permission.READ_ID_ACCOUNT" />
    <uses-permission android:name="cloud.hubera.permission.WRITE_ID_ACCOUNT" />
    <uses-permission android:name="fr.cloudity.permission.READ_AUTH_BROKER" />
    <uses-permission android:name="fr.cloudity.permission.WRITE_AUTH_BROKER" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <uses-permission android:name="android.permission.USE_CREDENTIALS" />

    <queries>
        <package android:name="cloud.hubera.id" />
        <package android:name="cloud.hubera.music" />
