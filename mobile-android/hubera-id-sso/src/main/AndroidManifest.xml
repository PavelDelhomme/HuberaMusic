        <provider android:authorities="cloud.hubera.drive.hubera.id" />
        <provider android:authorities="cloud.hubera.photos.hubera.id" />
        <provider android:authorities="cloud.hubera.calendar.hubera.id" />
        <provider android:authorities="cloud.hubera.contacts.hubera.id" />
        <provider android:authorities="cloud.hubera.jobs.hubera.id" />
        <provider android:authorities="cloud.hubera.notes.hubera.id" />
        <provider android:authorities="cloud.hubera.cook.hubera.id" />
        <provider android:authorities="cloud.hubera.office.hubera.id" />
        <provider android:authorities="cloud.hubera.row.hubera.id" />
        <provider android:authorities="cloud.hubera.office.docs.hubera.id" />
        <provider android:authorities="cloud.hubera.slides.hubera.id" />
        <provider android:authorities="cloud.hubera.budget.hubera.id" />
        <provider android:authorities="cloud.hubera.stream.hubera.id" />
        <provider android:authorities="cloud.hubera.cms.hubera.id" />
        <provider android:authorities="cloud.hubera.mail.cloudity.auth" />
        <provider android:authorities="cloud.hubera.drive.cloudity.auth" />
        <provider android:authorities="cloud.hubera.photos.cloudity.auth" />
        <provider android:authorities="cloud.hubera.pass.cloudity.auth" />
        <provider android:authorities="cloud.hubera.calendar.cloudity.auth" />
        <provider android:authorities="cloud.hubera.contacts.cloudity.auth" />
        <provider android:authorities="cloud.hubera.notes.cloudity.auth" />
        <provider android:authorities="cloud.hubera.tasks.cloudity.auth" />
        <provider android:authorities="cloud.hubera.cook.cloudity.auth" />
        <provider android:authorities="cloud.hubera.admin.cloudity.auth" />
        <intent>
            <action android:name="android.accounts.AccountAuthenticator" />
        </intent>
    </queries>

    <application>
        <provider
            android:name="cloud.hubera.id.sso.HuberaIdProvider"
            android:authorities="${applicationId}.hubera.id"
            android:exported="true"
            android:readPermission="cloud.hubera.permission.READ_ID_ACCOUNT"
            android:writePermission="cloud.hubera.permission.WRITE_ID_ACCOUNT" />
        <service
            android:name="cloud.hubera.id.sso.HuberaIdAuthService"
            android:exported="true"
            android:permission="android.permission.ACCOUNT_MANAGER">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/hubera_id_authenticator" />
        </service>
    </application>
</manifest>
